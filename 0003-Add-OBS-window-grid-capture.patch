+/**
+ * @file tests/unit/test_obs_grid_layout.cpp
+ * @brief Test src/platform/windows/obs_grid_layout.h (grid layout and hit testing for the OBS capture).
+ */
+// test includes
+#include "../tests_common.h"
+
+// local includes
+#include <src/platform/windows/obs_grid_layout.h>
+
+namespace {
+  bool overlaps(const obsgrid::rect_f &a, const obsgrid::rect_f &b) {
+    return a.x < b.x + b.w && b.x < a.x + a.w && a.y < b.y + b.h && b.y < a.y + a.h;
+  }
+}  // namespace
+
+TEST(ObsGridLayout, OneToTenWindowsNeverOverlapAndStayInside) {
+  const obsgrid::size_i sizes[10] = {{1280, 720}, {800, 600}, {1920, 1080}, {400, 900}, {1000, 1000}, {640, 480}, {1600, 400}, {300, 300}, {1280, 800}, {2560, 1440}};
+  for (int n = 1; n <= 10; ++n) {
+    obsgrid::rect_f r[10];
+    obsgrid::layout(sizes, n, 1920, 1080, 8, r);
+    for (int i = 0; i < n; ++i) {
+      EXPECT_GT(r[i].w, 0.f);
+      EXPECT_GE(r[i].x, 0.f);
+      EXPECT_GE(r[i].y, 0.f);
+      EXPECT_LE(r[i].x + r[i].w, 1920.f);
+      EXPECT_LE(r[i].y + r[i].h, 1080.f);
+      for (int j = i + 1; j < n; ++j) {
+        EXPECT_FALSE(overlaps(r[i], r[j])) << n << " windows: " << i << " overlaps " << j;
+      }
+    }
+  }
+}
+
+TEST(ObsGridLayout, HitTestReturnsPositionInsideTheWindow) {
+  const obsgrid::size_i sizes[4] = {{800, 600}, {800, 600}, {800, 600}, {800, 600}};
+  obsgrid::rect_f r[4];
+  obsgrid::layout(sizes, 4, 1920, 1080, 8, r);
+  for (int i = 0; i < 4; ++i) {
+    obsgrid::hit_t hit;
+    ASSERT_TRUE(obsgrid::hit_test(r, 4, r[i].x + r[i].w * 0.25f, r[i].y + r[i].h * 0.75f, false, -1, hit));
+    EXPECT_EQ(hit.index, i);
+    EXPECT_NEAR(hit.u, 0.25f, 0.01f);
+    EXPECT_NEAR(hit.v, 0.75f, 0.01f);
+  }
+}
+
+TEST(ObsGridLayout, DragCanLeaveTheWindowButStaysOnIt) {
+  const obsgrid::size_i sizes[2] = {{800, 600}, {800, 600}};
+  obsgrid::rect_f r[2];
+  obsgrid::layout(sizes, 2, 1920, 1080, 8, r);
+  obsgrid::hit_t hit;
+  EXPECT_FALSE(obsgrid::hit_test(r, 2, -50.f, -50.f, false, -1, hit));
+  ASSERT_TRUE(obsgrid::hit_test(r, 2, 1900.f, 5.f, true, 0, hit));
+  EXPECT_EQ(hit.index, 0);
+  EXPECT_FLOAT_EQ(hit.u, 1.f);
+  EXPECT_FLOAT_EQ(hit.v, 0.f);
+}
