+/**
+ * @file src/platform/windows/obs_grid.h
+ * @brief Link between Sunshine and the obs-moonlight-grid OBS plugin (shared memory block).
+ */
+#pragma once
+
+#include "obs_grid_layout.h"
+#include "obs_grid_shm.h"
+
+#include <cstdint>
+
+namespace platf::obsgrid_link {
+  /** @brief Snapshot of the window grid published by the plugin. */
+  struct layout_t {
+    uint64_t seq = 0;
+    uint32_t n = 0;
+    ObsGridCell cells[OBSGRID_MAX_WINDOWS] = {};
+  };
+
+  /** @brief Open (or create) the shared block. Returns nullptr on failure. */
+  ObsGridShm *open();
+
+  /** @brief The shared block if it is already open, otherwise nullptr (never creates it). */
+  ObsGridShm *peek();
+
+  /** @brief True when the OBS plugin has been alive during the last 2 seconds. */
+  bool plugin_alive();
+
+  /** @brief Tell the plugin that a stream is running (call at least once per second). */
+  void heartbeat();
+
+  /** @brief Tell the plugin how big the canvas must be. */
+  void request(uint32_t width, uint32_t height, uint32_t fps);
+
+  /** @brief Copy the current grid layout. Returns false if the plugin is busy rewriting it. */
+  bool read_layout(layout_t &out);
+}  // namespace platf::obsgrid_link
