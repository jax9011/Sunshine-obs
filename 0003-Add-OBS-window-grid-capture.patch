+  /**
+   * @brief Frame source of the OBS grid capture: the GPU texture shared by the obs-moonlight-grid plugin.
+   *
+   * The plugin draws the grid of windows into a keyed-mutex texture; this object opens that texture on
+   * Sunshine's own D3D11 device and hands frames over without any CPU copy.
+   */
+  class obs_frame_source_t {
+  public:
+    /**
+     * @brief Connect to the plugin, request the canvas size and open the shared texture.
+     *
+     * @param display Display whose D3D11 device is used.
+     * @param config Stream configuration (the canvas gets the stream size).
+     * @return 0 on success; -1 when OBS is not ready (the caller then falls back to normal capture).
+     */
+    int init(display_base_t *display, const ::video::config_t &config);
+    /**
+     * @brief Wait for the next frame and lock the texture for reading.
+     *
+     * @param timeout Maximum time to wait.
+     * @param out Receives the (borrowed) texture.
+     * @return ok, timeout, or reinit when the plugin re-created its texture.
+     */
+    capture_e next_frame(std::chrono::milliseconds timeout, ID3D11Texture2D **out);
+    /**
+     * @brief Give the texture back to the plugin.
+     */
+    void release_frame();
+
+    int canvas_width {0};  ///< Width of the shared canvas in pixels.
+    int canvas_height {0};  ///< Height of the shared canvas in pixels.
+
+    ~obs_frame_source_t();
+
+  private:
+    texture2d_t texture;  ///< The shared texture opened on Sunshine's device.
+    keyed_mutex_t keyed_mutex;  ///< Keyed mutex of that texture.
+    uint32_t generation {0};  ///< Plugin texture generation we opened.
+    bool held {false};  ///< True while the keyed mutex is acquired.
+  };
+
+  /**
+   * Display backend that reads the OBS window grid with a software encoder.
+   */
+  class display_obs_ram_t: public display_ram_t {
