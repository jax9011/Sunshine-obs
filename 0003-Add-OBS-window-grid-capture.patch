diff --git a/src/platform/windows/display_obs.cpp b/src/platform/windows/display_obs.cpp
new file mode 100644
index 0000000..526a913
--- /dev/null
+++ b/src/platform/windows/display_obs.cpp
@@ -0,0 +1,192 @@
+/**
+ * @file src/platform/windows/display_obs.cpp
+ * @brief "obs" capture backend: the video is the window grid produced by the obs-moonlight-grid plugin.
+ *
+ * Enable with `capture = obs` in sunshine.conf. If OBS (with the plugin) is not running when a stream
+ * starts, Sunshine logs a warning and uses its normal capture instead.
+ */
+// standard includes
+#include <chrono>
+#include <thread>
+
+// local includes
+#include "display.h"
+#include "misc.h"
+#include "obs_grid.h"
+#include "obs_grid_input.h"
+#include "src/logging.h"
+
+namespace platf::dxgi {
+  using namespace std::literals;
+
+  int obs_frame_source_t::init(display_base_t *display, const ::video::config_t &config) {
+    if (config.dynamicRange) {
+      BOOST_LOG(warning) << "[obs-grid] HDR is not supported by the OBS grid"sv;
+      return -1;
+    }
+
+    auto *shm = obsgrid_link::open();
+    if (!shm) {
+      return -1;
+    }
+    if (!obsgrid_link::plugin_alive()) {
+      BOOST_LOG(warning) << "[obs-grid] the OBS plugin is not running. Start OBS (with obs-moonlight-grid) before streaming."sv;
+      return -1;
+    }
+
+    uint32_t want_w = (uint32_t) config.width, want_h = (uint32_t) config.height;
+    obsgrid_clamp_canvas(want_w, want_h);
+    obsgrid_link::request(want_w, want_h, (uint32_t) config.framerate);
+    obsgrid_link::heartbeat();
+
+    // The plugin builds a canvas of the requested size on its next frame.
+    bool ready = false;
+    for (int i = 0; i < 200; ++i) {  // up to 4 s
+      obsgrid_link::heartbeat();
+      if (shm->texture_handle && shm->canvas_w == want_w && shm->canvas_h == want_h && obsgrid_link::plugin_alive()) {
+        ready = true;
+        break;
+      }
+      std::this_thread::sleep_for(20ms);
+    }
+    if (!ready) {
+      BOOST_LOG(warning) << "[obs-grid] the OBS plugin did not produce a "sv << want_w << 'x' << want_h << " canvas (is OBS using the D3D11 renderer?)"sv;
+      return -1;
+    }
+
+    generation = shm->texture_gen;
+    const auto handle = reinterpret_cast<HANDLE>((uintptr_t) shm->texture_handle);
+    HRESULT status = display->device->OpenSharedResource(handle, IID_ID3D11Texture2D, (void **) &texture);
+    if (FAILED(status)) {
+      BOOST_LOG(error) << "[obs-grid] cannot open the OBS texture [0x"sv << util::hex(status).to_string_view() << "]. OBS and Sunshine must use the same GPU."sv;
+      return -1;
+    }
+    status = texture->QueryInterface(IID_IDXGIKeyedMutex, (void **) &keyed_mutex);
+    if (FAILED(status)) {
+      BOOST_LOG(error) << "[obs-grid] the OBS texture has no keyed mutex [0x"sv << util::hex(status).to_string_view() << ']';
+      return -1;
+    }
+
+    D3D11_TEXTURE2D_DESC desc;
+    texture->GetDesc(&desc);
+    if (desc.Format != DXGI_FORMAT_B8G8R8A8_UNORM) {
+      BOOST_LOG(error) << "[obs-grid] unexpected OBS texture format "sv << (int) desc.Format;
+      return -1;
+    }
+    canvas_width = (int) desc.Width;
+    canvas_height = (int) desc.Height;
+    obsgrid_input::reset();
+    BOOST_LOG(info) << "[obs-grid] capturing the OBS window grid, "sv << canvas_width << 'x' << canvas_height;
+    return 0;
+  }
+
+  capture_e obs_frame_source_t::next_frame(std::chrono::milliseconds timeout, ID3D11Texture2D **out) {
+    release_frame();
+    obsgrid_link::heartbeat();
+
+    auto *shm = obsgrid_link::peek();
+    if (!shm || shm->texture_gen != generation) {
+      return capture_e::reinit;  // the plugin made a new texture (size change, OBS restart)
+    }
+
+    const HRESULT status = keyed_mutex->AcquireSync(1, (DWORD) timeout.count());
+    if (status == (HRESULT) WAIT_TIMEOUT) {
+      return capture_e::timeout;
+    }
+    if (FAILED(status)) {
+      BOOST_LOG(warning) << "[obs-grid] AcquireSync failed [0x"sv << util::hex(status).to_string_view() << ']';
+      return capture_e::reinit;
+    }
+    held = true;
+    *out = texture.get();
+    return capture_e::ok;
+  }
+
+  void obs_frame_source_t::release_frame() {
+    if (held) {
+      keyed_mutex->ReleaseSync(0);
+      held = false;
+    }
+  }
+
+  obs_frame_source_t::~obs_frame_source_t() {
+    release_frame();
+  }
+
+  // -----------------------------------------------------------------------------------------
+  // software encoder path
+  // -----------------------------------------------------------------------------------------
+
+  int display_obs_ram_t::init(const ::video::config_t &config, const std::string &display_name) {
+    if (display_base_t::init(config, display_name) || source.init(this, config)) {
+      return -1;
+    }
+
+    // The picture is the grid canvas, not a monitor. Input coordinates arrive in canvas pixels
+    // and are mapped to the real windows by obsgrid_input.
+    width = width_before_rotation = source.canvas_width;
+    height = height_before_rotation = source.canvas_height;
+    offset_x = offset_y = 0;
+    capture_format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    texture.reset();
+    return 0;
+  }
+
+  capture_e display_obs_ram_t::snapshot(const pull_free_image_cb_t &pull_free_image_cb, std::shared_ptr<platf::img_t> &img_out, std::chrono::milliseconds timeout, bool) {
+    HRESULT status;
+    ID3D11Texture2D *src = nullptr;
+    auto capture_status = source.next_frame(timeout, &src);
+    if (capture_status != capture_e::ok) {
+      return capture_status;
+    }
+
+    if (texture == nullptr) {
+      D3D11_TEXTURE2D_DESC t {};
+      t.Width = width;
+      t.Height = height;
+      t.MipLevels = 1;
+      t.ArraySize = 1;
+      t.SampleDesc.Count = 1;
+      t.Usage = D3D11_USAGE_STAGING;
+      t.Format = capture_format;
+      t.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+
+      status = device->CreateTexture2D(&t, nullptr, &texture);
+      if (FAILED(status)) {
+        BOOST_LOG(error) << "Failed to create staging texture [0x"sv << util::hex(status).to_string_view() << ']';
+        source.release_frame();
+        return capture_e::capture_error;
+      }
+    }
+
+    device_ctx->CopyResource(texture.get(), src);
+    source.release_frame();  // the plugin may draw the next frame while we read this one
+
+    if (!pull_free_image_cb(img_out)) {
+      return capture_e::interrupted;
+    }
+    auto img = (img_t *) img_out.get();
+
+    if (FAILED(status = device_ctx->Map(texture.get(), 0, D3D11_MAP_READ, 0, &img_info))) {
+      BOOST_LOG(error) << "Failed to map texture [0x"sv << util::hex(status).to_string_view() << ']';
+      return capture_e::capture_error;
+    }
+    if (complete_img(img, false)) {
+      device_ctx->Unmap(texture.get(), 0);
+      img_info.pData = nullptr;
+      return capture_e::capture_error;
+    }
+
+    std::copy_n((std::uint8_t *) img_info.pData, height * img_info.RowPitch, (std::uint8_t *) img->data);
+    device_ctx->Unmap(texture.get(), 0);
+    img_info.pData = nullptr;
+
+    img->frame_timestamp = std::chrono::steady_clock::now();
+    return capture_e::ok;
+  }
+
+  capture_e display_obs_ram_t::release_snapshot() {
+    source.release_frame();
+    return capture_e::ok;
+  }
+}  // namespace platf::dxgi
