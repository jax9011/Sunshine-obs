+/**
+ * @file src/platform/windows/obs_grid_input.h
+ * @brief Input side of the OBS grid capture: maps a touch/click on the grid to the real PC window.
+ *
+ * Portable header (no Windows includes) so src/input.cpp can use it on every platform.
+ * On non-Windows builds everything is an inert stub.
+ */
+#pragma once
+
+#include <optional>
+#include <utility>
+
+namespace obsgrid_input {
+#ifdef _WIN32
+  /** @brief True while a stream is being captured from the OBS grid. */
+  bool active();
+
+  /**
+   * @brief Map a point of the grid canvas (pixels) to the real screen.
+   * @return Position in pixels relative to the top-left corner of the virtual desktop, or nothing
+   *         when the point is not on a window (the event must then be dropped).
+   */
+  std::optional<std::pair<float, float>> map_abs(float canvas_x, float canvas_y);
+
+  /** @brief Relative mouse movement (trackpad mode): moves a virtual pointer on the grid, then maps it. */
+  std::optional<std::pair<float, float>> map_rel(int dx, int dy);
+
+  /** @brief A button / finger went down: bring the window under the pointer to the front. */
+  void on_press();
+
+  /** @brief A button / finger went up. */
+  void on_release();
+
+  /** @brief Forget pointer state (called whenever a new OBS grid capture starts). */
+  void reset();
+#else
+  inline bool active() {
+    return false;
+  }
+
+  inline std::optional<std::pair<float, float>> map_abs(float, float) {
+    return std::nullopt;
+  }
+
+  inline std::optional<std::pair<float, float>> map_rel(int, int) {
+    return std::nullopt;
+  }
+
+  inline void on_press() {}
+
+  inline void on_release() {}
+
+  inline void reset() {}
+#endif
+}  // namespace obsgrid_input
diff --git a/src/platform/windows/obs_grid_layout.h b/src/platform/windows/obs_grid_layout.h
new file mode 100644
index 0000000..89974e7
--- /dev/null
+++ b/src/platform/windows/obs_grid_layout.h
@@ -0,0 +1,127 @@
+// Pure C++17 (no platform dependencies). Shared by the OBS plugin (builds the grid)
+// and by Sunshine (maps a touch/click on the grid back to the right window).
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace obsgrid {
+
+  struct rect_f {
+    float x = 0, y = 0, w = 0, h = 0;
+  };
+
+  struct size_i {
+    int w = 0, h = 0;
+  };
+
+  struct hit_t {
+    int index = -1;  // which window
+    float u = 0;  // 0..1 across the window content (left -> right)
+    float v = 0;  // 0..1 down the window content (top -> bottom)
+  };
+
+  constexpr float kMaxUpscale = 2.0f;  // never blow a small window up more than 2x
+
+  // Scale that fits (sw x sh) inside (cw x ch) keeping the aspect ratio.
+  inline float fit_scale(int sw, int sh, float cw, float ch) {
+    if (sw <= 0 || sh <= 0 || cw <= 0 || ch <= 0) {
+      return 0.f;
+    }
+    return std::min({cw / (float) sw, ch / (float) sh, kMaxUpscale});
+  }
+
+  // Row-major split of n items in `cols` columns; the last row is stretched across the full width.
+  inline int items_in_row(int n, int cols, int row) {
+    const int rows = (n + cols - 1) / cols;
+    return row < rows - 1 ? cols : n - cols * (rows - 1);
+  }
+
+  // Lay out n windows (sizes in src) on a canvas. out[i] = rectangle that window i occupies, in canvas pixels.
+  // The number of columns is chosen to waste the least canvas area.
+  inline void layout(const size_i *src, int n, int canvas_w, int canvas_h, int gap, rect_f *out) {
+    if (n <= 0) {
+      return;
+    }
+    int best_cols = 1;
+    float best_score = -1.f;
+    for (int cols = 1; cols <= n; ++cols) {
+      const int rows = (n + cols - 1) / cols;
+      const float ch = (float) canvas_h / rows - gap;
+      float score = 0.f;
+      for (int i = 0; i < n; ++i) {
+        const int row = i / cols;
+        const float cw = (float) canvas_w / items_in_row(n, cols, row) - gap;
+        const float s = fit_scale(src[i].w, src[i].h, cw, ch);
+        score += s * s * (float) src[i].w * (float) src[i].h;
+      }
+      if (score > best_score + 1.f) {  // ties keep fewer columns
+        best_score = score;
+        best_cols = cols;
+      }
+    }
+
+    const int cols = best_cols;
+    const int rows = (n + cols - 1) / cols;
+    const float cell_h = (float) canvas_h / rows;
+    for (int i = 0; i < n; ++i) {
+      const int row = i / cols;
+      const int in_row = items_in_row(n, cols, row);
+      const int col = i - row * cols;
+      const float cell_w = (float) canvas_w / in_row;
+      const float s = fit_scale(src[i].w, src[i].h, cell_w - gap, cell_h - gap);
+      const float w = (float) src[i].w * s, h = (float) src[i].h * s;
+      out[i].x = std::floor(col * cell_w + (cell_w - w) * 0.5f);
+      out[i].y = std::floor(row * cell_h + (cell_h - h) * 0.5f);
+      out[i].w = std::floor(w);
+      out[i].h = std::floor(h);
+    }
+  }
+
+  // Which window is under canvas point (x, y)?
+  // clamp_nearest = true (used while a button is held, so a drag can leave the window):
+  // the point is pulled to the preferred window, or to the nearest one.
+  inline bool hit_test(const rect_f *rects, int n, float x, float y, bool clamp_nearest, int prefer, hit_t &out) {
+    auto fill = [&](int i) {
+      const rect_f &r = rects[i];
+      out.index = i;
+      out.u = r.w > 0 ? std::clamp((x - r.x) / r.w, 0.f, 1.f) : 0.f;
+      out.v = r.h > 0 ? std::clamp((y - r.y) / r.h, 0.f, 1.f) : 0.f;
+    };
+    for (int i = n - 1; i >= 0; --i) {  // later = drawn on top
+      const rect_f &r = rects[i];
+      if (r.w > 0 && r.h > 0 && x >= r.x && x < r.x + r.w && y >= r.y && y < r.y + r.h) {
+        fill(i);
+        return true;
+      }
+    }
+    if (!clamp_nearest || n <= 0) {
+      return false;
+    }
+    if (prefer >= 0 && prefer < n && rects[prefer].w > 0) {
+      fill(prefer);
+      return true;
+    }
+    int best = -1;
+    float best_d = 1e30f;
+    for (int i = 0; i < n; ++i) {
+      const rect_f &r = rects[i];
+      if (r.w <= 0 || r.h <= 0) {
+        continue;
+      }
+      const float dx = std::max({r.x - x, 0.f, x - (r.x + r.w)});
+      const float dy = std::max({r.y - y, 0.f, y - (r.y + r.h)});
+      const float d = dx * dx + dy * dy;
+      if (d < best_d) {
+        best_d = d;
+        best = i;
+      }
+    }
+    if (best < 0) {
+      return false;
+    }
+    fill(best);
+    return true;
+  }
+
+}  // namespace obsgrid
diff --git a/src/platform/windows/obs_grid_shm.h b/src/platform/windows/obs_grid_shm.h
new file mode 100644
