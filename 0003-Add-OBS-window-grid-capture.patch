+// Shared between the OBS plugin (obs-moonlight-grid) and Sunshine (display_obs / input hook).
+// A small (<4 KB) shared-memory block; the video itself travels as a GPU shared texture.
+// Whoever starts first creates the mapping (open-or-create), so start order does not matter.
+#pragma once
+#include <stdint.h>
+
+#define OBSGRID_SHM_NAME_LOCAL  L"Local\\SunshineObsGrid"
+#define OBSGRID_SHM_NAME_GLOBAL L"Global\\SunshineObsGrid"
+#define OBSGRID_MAGIC           0x4F424731u  // 'OBG1'
+#define OBSGRID_VERSION         3
+#define OBSGRID_MAX_WINDOWS     10
+#define OBSGRID_MAX_W           3840
+#define OBSGRID_MAX_H           2160
+#define OBSGRID_SCENE_NAME      "Moonlight"  // OBS scene whose visible Window Capture sources are streamed
+
+#define OBSGRID_FLAG_CLIENT_AREA 1u  // the OBS source captures the client area only (not the frame)
+
+#pragma pack(push, 8)
+struct ObsGridCell {
+  float x, y, w, h;  // where the window is drawn inside the canvas (pixels)
+  int32_t src_w, src_h;  // size of the captured window image
+  int64_t hwnd;  // the real PC window (0 = not found, input is ignored)
+  uint32_t flags;
+  uint32_t pad;
+  char name[64];  // OBS source name (UTF-8)
+};
+
+struct ObsGridShm {
+  uint32_t magic;
+  uint32_t version;
+
+  // Sunshine -> plugin
+  volatile uint64_t sunshine_heartbeat_ms;  // GetTickCount64() while a stream is being captured
+  volatile uint32_t requested_w, requested_h;  // wanted canvas size (the client's stream size)
+  volatile uint32_t requested_fps;
+
+  // plugin -> Sunshine
+  volatile uint64_t plugin_heartbeat_ms;  // GetTickCount64(), refreshed ~4x per second
+  volatile uint32_t canvas_w, canvas_h;  // size of the shared texture
+  volatile uint32_t texture_handle;  // legacy DXGI shared handle (keyed-mutex texture), 0 = none
+  volatile uint32_t texture_gen;  // changes whenever the texture is re-created
+  volatile uint64_t frame_seq;  // incremented for each new frame
+
+  // layout (seqlock: odd value = being written)
+  volatile uint64_t layout_seq;
+  uint32_t window_count;
+  uint32_t pad;
+  ObsGridCell cells[OBSGRID_MAX_WINDOWS];
+};
+#pragma pack(pop)
+static_assert(sizeof(ObsGridShm) < 4096, "ObsGridShm must fit one page");
+#define OBSGRID_SHM_BYTES 4096
+
+// Canvas size rule shared by both sides: the client's stream size, even numbers, sane limits.
+#ifdef __cplusplus
+static inline void obsgrid_clamp_canvas(uint32_t &w, uint32_t &h) {
+  if (w < 320 || h < 240 || w > OBSGRID_MAX_W || h > OBSGRID_MAX_H) {
+    w = 1920;
+    h = 1080;
+  }
+  w &= ~1u;
+  h &= ~1u;
+}
+#endif
+
+// Keyed-mutex protocol (no tearing, no extra copies):
+//   plugin :  AcquireSync(0)  -> draw frame -> ReleaseSync(1)
+//   Sunshine: AcquireSync(1)  -> copy frame -> ReleaseSync(0)
