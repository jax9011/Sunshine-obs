diff --git a/src/platform/windows/obs_grid.cpp b/src/platform/windows/obs_grid.cpp
new file mode 100644
index 0000000..49ade1d
--- /dev/null
+++ b/src/platform/windows/obs_grid.cpp
@@ -0,0 +1,307 @@
+/**
+ * @file src/platform/windows/obs_grid.cpp
+ * @brief Shared-memory link to the OBS plugin and the grid -> window input mapping.
+ */
+// standard includes
+#include <algorithm>
+#include <chrono>
+#include <cstring>
+#include <mutex>
+
+// platform includes
+#include <dwmapi.h>
+#include <sddl.h>
+#include <windows.h>
+
+// local includes
+#include "obs_grid.h"
+#include "obs_grid_input.h"
+#include "src/logging.h"
+
+namespace platf::obsgrid_link {
+  using namespace std::literals;
+
+  namespace {
+    std::mutex open_mutex;
+    HANDLE map_handle = nullptr;
+    ObsGridShm *shm_ptr = nullptr;
+  }  // namespace
+
+  ObsGridShm *open() {
+    std::lock_guard lg {open_mutex};
+    if (shm_ptr) {
+      return shm_ptr;
+    }
+
+    PSECURITY_DESCRIPTOR psd = nullptr;
+    // SYSTEM + administrators + the interactive (logged-on) user. Nobody else.
+    ConvertStringSecurityDescriptorToSecurityDescriptorW(L"D:(A;;GA;;;SY)(A;;GA;;;BA)(A;;GA;;;IU)", SDDL_REVISION_1, &psd, nullptr);
+    SECURITY_ATTRIBUTES sa {sizeof(sa), psd, FALSE};
+    for (const wchar_t *name : {OBSGRID_SHM_NAME_LOCAL, OBSGRID_SHM_NAME_GLOBAL}) {
+      map_handle = CreateFileMappingW(INVALID_HANDLE_VALUE, psd ? &sa : nullptr, PAGE_READWRITE, 0, OBSGRID_SHM_BYTES, name);
+      if (map_handle) {
+        break;
+      }
+    }
+    if (psd) {
+      LocalFree(psd);
+    }
+    if (!map_handle) {
+      BOOST_LOG(error) << "[obs-grid] CreateFileMapping failed: "sv << GetLastError();
+      return nullptr;
+    }
+    void *p = MapViewOfFile(map_handle, FILE_MAP_ALL_ACCESS, 0, 0, OBSGRID_SHM_BYTES);
+    if (!p) {
+      BOOST_LOG(error) << "[obs-grid] MapViewOfFile failed: "sv << GetLastError();
+      CloseHandle(map_handle);
+      map_handle = nullptr;
+      return nullptr;
+    }
+    auto *s = static_cast<ObsGridShm *>(p);
+    if (s->magic != OBSGRID_MAGIC) {  // first one to arrive initialises the block
+      std::memset(s, 0, OBSGRID_SHM_BYTES);
+      s->version = OBSGRID_VERSION;
+      MemoryBarrier();
+      s->magic = OBSGRID_MAGIC;
+    }
+    if (s->version != OBSGRID_VERSION) {
+      BOOST_LOG(error) << "[obs-grid] shared memory version "sv << s->version << " != "sv << OBSGRID_VERSION << ": update Sunshine and the OBS plugin together"sv;
+      UnmapViewOfFile(p);
+      CloseHandle(map_handle);
+      map_handle = nullptr;
+      return nullptr;
+    }
+    shm_ptr = s;
+    return shm_ptr;
+  }
+
+  ObsGridShm *peek() {
+    return shm_ptr;
+  }
+
+  bool plugin_alive() {
+    auto *s = peek();
+    if (!s || !s->plugin_heartbeat_ms) {
+      return false;
+    }
+    return GetTickCount64() - s->plugin_heartbeat_ms < 2000;
+  }
+
+  void heartbeat() {
+    if (auto *s = peek()) {
+      s->sunshine_heartbeat_ms = GetTickCount64();
+    }
+  }
+
+  void request(uint32_t width, uint32_t height, uint32_t fps) {
+    if (auto *s = peek()) {
+      s->requested_w = width;
+      s->requested_h = height;
+      s->requested_fps = fps;
+    }
+  }
+
+  bool read_layout(layout_t &out) {
+    auto *s = peek();
+    if (!s) {
+      return false;
+    }
+    for (int tries = 0; tries < 20; ++tries) {
+      const uint64_t a = s->layout_seq;
+      if (a & 1) {  // the plugin is writing
+        Sleep(0);
+        continue;
+      }
+      MemoryBarrier();
+      const uint32_t n = std::min<uint32_t>(s->window_count, OBSGRID_MAX_WINDOWS);
+      std::memcpy(out.cells, (const void *) s->cells, sizeof(ObsGridCell) * n);
+      MemoryBarrier();
+      if (s->layout_seq == a) {
+        out.n = n;
+        out.seq = a;
+        return true;
+      }
+    }
+    return false;
+  }
+}  // namespace platf::obsgrid_link
+
+// ---------------------------------------------------------------------------------------------
+// grid -> real window
+// ---------------------------------------------------------------------------------------------
+namespace obsgrid_input {
+  using namespace std::literals;
+
+  namespace {
+    std::mutex state_mutex;
+    platf::obsgrid_link::layout_t layout;
+    int target_index = -1;  // window under the pointer
+    HWND target_hwnd = nullptr;
+    int buttons_down = 0;  // buttons / fingers currently down: a drag may leave the window
+    float virt_x = -1.f, virt_y = -1.f;  // virtual pointer for relative (trackpad) mode, canvas pixels
+    ULONGLONG last_restore[OBSGRID_MAX_WINDOWS] = {};
+
+    bool window_rect(HWND h, bool client_area, RECT &r) {
+      if (!h || !IsWindow(h)) {
+        return false;
+      }
+      if (client_area) {
+        RECT c;
+        POINT p {0, 0};
+        if (!GetClientRect(h, &c) || !ClientToScreen(h, &p)) {
+          return false;
+        }
+        r = {p.x, p.y, p.x + c.right, p.y + c.bottom};
+        return true;
+      }
+      if (SUCCEEDED(DwmGetWindowAttribute(h, DWMWA_EXTENDED_FRAME_BOUNDS, &r, sizeof(r)))) {
+        return true;
+      }
+      return GetWindowRect(h, &r) != 0;
+    }
+
+    RECT virtual_screen() {
+      const int x = GetSystemMetrics(SM_XVIRTUALSCREEN), y = GetSystemMetrics(SM_YVIRTUALSCREEN);
+      return {x, y, x + GetSystemMetrics(SM_CXVIRTUALSCREEN), y + GetSystemMetrics(SM_CYVIRTUALSCREEN)};
+    }
+
+    bool on_screen(const RECT &r) {
+      RECT vs = virtual_screen(), out;
+      return IntersectRect(&out, &vs, &r) != 0 && (out.right - out.left) > 8 && (out.bottom - out.top) > 8;
+    }
+
+    // A minimised or off-screen window cannot be captured: bring it back (at most twice a second).
+    void ensure_visible(int index, HWND h) {
+      const ULONGLONG now = GetTickCount64();
+      if (index < 0 || now - last_restore[index] < 500) {
+        return;
+      }
+      last_restore[index] = now;
+      if (IsIconic(h)) {
+        ShowWindow(h, SW_RESTORE);
+      }
+      RECT r;
+      if (GetWindowRect(h, &r) && !on_screen(r)) {
+        const RECT vs = virtual_screen();
+        SetWindowPos(h, nullptr, vs.left + 40, vs.top + 40, 0, 0, SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE);
+      }
+    }
+
+    void raise(HWND h) {
+      if (!h || !IsWindow(h)) {
+        return;
+      }
+      if (IsIconic(h)) {
+        ShowWindow(h, SW_RESTORE);
+      }
+      if (GetForegroundWindow() == h) {
+        return;
+      }
+      const DWORD me = GetCurrentThreadId();
+      const DWORD fg = GetWindowThreadProcessId(GetForegroundWindow(), nullptr);
+      const bool attached = fg && fg != me && AttachThreadInput(me, fg, TRUE);
+      SetWindowPos(h, HWND_TOP, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_SHOWWINDOW);
+      BringWindowToTop(h);
+      SetForegroundWindow(h);
+      if (attached) {
+        AttachThreadInput(me, fg, FALSE);
+      }
+    }
+
+    std::optional<std::pair<float, float>> map_locked(float cx, float cy) {
+      auto *s = platf::obsgrid_link::peek();
+      if (!s) {
+        return std::nullopt;
+      }
+      if (layout.seq != s->layout_seq || layout.seq == 0) {
+        platf::obsgrid_link::layout_t fresh;
+        if (platf::obsgrid_link::read_layout(fresh)) {
+          layout = fresh;
+        }
+      }
+      if (layout.n == 0) {
+        return std::nullopt;
+      }
+
+      obsgrid::rect_f rects[OBSGRID_MAX_WINDOWS];
+      for (uint32_t i = 0; i < layout.n; ++i) {
+        rects[i] = {layout.cells[i].x, layout.cells[i].y, layout.cells[i].w, layout.cells[i].h};
+      }
+      obsgrid::hit_t hit;
+      if (!obsgrid::hit_test(rects, (int) layout.n, cx, cy, buttons_down > 0, target_index, hit)) {
+        return std::nullopt;  // gutter between windows
+      }
+
+      const ObsGridCell &cell = layout.cells[hit.index];
+      HWND h = reinterpret_cast<HWND>((intptr_t) cell.hwnd);
+      RECT r;
+      if (!h || !window_rect(h, (cell.flags & OBSGRID_FLAG_CLIENT_AREA) != 0, r)) {
+        return std::nullopt;  // window not found (closed, or the plugin has not resolved it yet)
+      }
+      if (IsIconic(h) || !on_screen(r)) {
+        ensure_visible(hit.index, h);
+        return std::nullopt;  // the next event maps normally
+      }
+
+      target_index = hit.index;
+      target_hwnd = h;
+      const float rx = (float) r.left + hit.u * (float) std::max<LONG>(0, r.right - r.left - 1);
+      const float ry = (float) r.top + hit.v * (float) std::max<LONG>(0, r.bottom - r.top - 1);
+      return std::pair<float, float> {rx - (float) GetSystemMetrics(SM_XVIRTUALSCREEN), ry - (float) GetSystemMetrics(SM_YVIRTUALSCREEN)};
+    }
+  }  // namespace
+
+  bool active() {
+    auto *s = platf::obsgrid_link::peek();
+    if (!s || !s->sunshine_heartbeat_ms) {
+      return false;
+    }
+    return GetTickCount64() - s->sunshine_heartbeat_ms < 1500;
+  }
+
+  std::optional<std::pair<float, float>> map_abs(float canvas_x, float canvas_y) {
+    std::lock_guard lg {state_mutex};
+    virt_x = canvas_x;  // keep the relative-mode pointer where the finger / mouse last was
+    virt_y = canvas_y;
+    return map_locked(canvas_x, canvas_y);
+  }
+
+  std::optional<std::pair<float, float>> map_rel(int dx, int dy) {
+    std::lock_guard lg {state_mutex};
+    auto *s = platf::obsgrid_link::peek();
+    if (!s) {
+      return std::nullopt;
+    }
+    const float cw = (float) s->canvas_w, ch = (float) s->canvas_h;
+    if (cw <= 0 || ch <= 0) {
+      return std::nullopt;
+    }
+    if (virt_x < 0) {
+      virt_x = cw * 0.5f;
+      virt_y = ch * 0.5f;
+    }
+    virt_x = std::clamp(virt_x + (float) dx, 0.f, cw - 1.f);
+    virt_y = std::clamp(virt_y + (float) dy, 0.f, ch - 1.f);
+    return map_locked(virt_x, virt_y);
+  }
+
+  void on_press() {
+    std::lock_guard lg {state_mutex};
+    ++buttons_down;
+    raise(target_hwnd);
+  }
+
+  void on_release() {
+    std::lock_guard lg {state_mutex};
+    buttons_down = std::max(0, buttons_down - 1);
+  }
+
+  void reset() {
+    std::lock_guard lg {state_mutex};
+    buttons_down = 0;
+    target_index = -1;
+    target_hwnd = nullptr;
+    virt_x = virt_y = -1.f;
+    layout = {};
+  }
+}  // namespace obsgrid_input
